{
  "_comment": "Copy this to discovery.credentials.json (gitignored -- never commit your real one). Never exposed through the REST API -- only discovery.py/snmp_client.py/ssh_client.py read this file. For the common single-credential case, prefer the NETTRACE_SNMP_COMMUNITY / NETTRACE_SSH_USER / NETTRACE_SSH_PASS env vars instead and skip this file entirely; use by_cidr here only when different subnets/vendors need different credentials.",
  "default": {
    "snmp_community": "public",
    "ssh_username": null,
    "ssh_password": null
  },
  "by_cidr": [
    {
      "cidr": "192.168.2.0/24",
      "snmp_community": "other-community-string",
      "ssh_username": "admin",
      "ssh_password": "change-me"
    }
  ]
}
